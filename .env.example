# Docker production config
# Use URL-safe characters only in MYSQL_ROOT_PASSWORD (letters, numbers, . _ -)
# If any value contains $, wrap it in single quotes in the real .env file.

MYSQL_ROOT_PASSWORD=change-me-now
MYSQL_DATABASE=terceirogestor

# Local development values reused by backend/frontend outside Docker.
PORT=3001
DATABASE_URL=mysql://root:change-me-now@localhost:3306/terceirogestor?allowPublicKeyRetrieval=true&ssl=false
SHADOW_DATABASE_URL=
API_INTERNAL_URL=http://localhost:3001

APP_NAME=Terceiro Gestor
JWT_SECRET=change-me-now
WEB_URL=http://localhost

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PWA_SW=0
NEXT_PUBLIC_PWA_FORCE_INSTALL=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@terceirogestor.local

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/registration/oauth/google/callback

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost/api/registration/oauth/microsoft/callback

BACKUP_PATH=./storage/backups
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAYS=14
TZ=America/Sao_Paulo

# Master key (base64) for encrypting PII at rest (CPF/RG/NIS/CNS).
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_MASTER_KEY=""

# 32-byte key (hex 64 chars or base64). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""
