# ============================================================
# DOCKER COMPOSE - SERVIÇOS INDIVIDUAIS
# ============================================================
# Este arquivo configura PostgreSQL, Backend (NestJS) e Frontend (Next.js)
# rodando em docker-compose.yml separados.

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=terceirogestor
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
# Para docker network interno, use: postgres
# Para conexão do host, use: localhost:5432
POSTGRES_HOST=postgres

# --- Backend Configuration ---
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3001
BACKEND_HOST=backend

# --- Frontend Configuration ---
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# --- Database URLs ---
# Para backend rodando em Docker: DATABASE_URL aponta para "postgres" (hostname interno)
# Para backend rodando local: DATABASE_URL aponta para localhost
DATABASE_URL=postgresql://postgres:change-me-now@postgres:5432/terceirogestor
SHADOW_DATABASE_URL=postgresql://postgres:change-me-now@postgres:5432/terceirogestor_shadow

# API interno (Backend -> Frontend)
API_INTERNAL_URL=http://backend:3001

# --- Application Settings ---
APP_NAME=Terceiro Gestor
JWT_SECRET=change-me-now

# --- Public URL ---
# Usado para links, redirects e cookie security.
# Valores comuns:
#   Local dev: http://localhost
#   LAN/prod: http://192.168.1.250 ou seu domínio
WEB_URL=http://localhost

# --- Frontend Public API endpoint ---
# Frontend faz requests via este endpoint público (deve incluir /api)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PWA_SW=0
NEXT_PUBLIC_PWA_FORCE_INSTALL=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@terceirogestor.local

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/registration/oauth/google/callback

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost/api/registration/oauth/microsoft/callback

TZ=America/Sao_Paulo

# Master key (base64) for encrypting PII at rest (CPF/RG/NIS/CNS).
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_MASTER_KEY=""

# 32-byte key (hex 64 chars or base64). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""

# ============================================================
# GOOGLE CLOUD PLATFORM (Cloud Run / Cloud SQL / Cloud Storage)
# ============================================================
# Google Cloud Project ID (e.g., "meu-projeto-gcp-123")
GCP_PROJECT_ID=""

# Cloud Storage bucket for file uploads
GCP_BUCKET_NAME=""

# Cloud Storage Signed URL TTL (in seconds)
# HIGH sensitivity (health documents, RG): 5-10 min
GCS_SIGNED_URL_TTL_SENSITIVE=300
# MEDIUM sensitivity (programs, projects): 30 min  
GCS_SIGNED_URL_TTL_MEDIUM=1800
# LOW sensitivity (avatars, logos): 1 hour
GCS_SIGNED_URL_TTL_LOW=3600

# Cloud SQL (instead of local MySQL in docker-compose)
# For Cloud SQL Proxy: mysql+cloudsql://user:pass@project:region:instance/database
# Format: mysql://{user}:{password}@{host}/{database}?sslMode=require
# Cloud Run will inject via Secret Manager in production
CLOUD_SQL_CONNECTION_NAME=""

# Application Default Credentials
# In Cloud Run, this is automatic via service account
# For local testing: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=""
