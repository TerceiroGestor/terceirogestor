# Docker Compose (root)
# On Windows, if you prefer data outside the repo, use a path like C:/docker-data/system_development
DATA_DIR=./data
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=terceirogestor
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://backend:3001
NGINX_SERVER_NAME=localhost
NGINX_PRIMARY_DOMAIN=localhost

# Backup settings (seconds / days)
BACKUP_KEEP_DAYS=7
TZ=UTC
