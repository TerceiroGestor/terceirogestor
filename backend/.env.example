# Backend - Variáveis de Ambiente

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=seu_password_seguro
POSTGRES_DB=terceirogestor

# Node
NODE_ENV=production
PORT=3001

# Segurança
JWT_SECRET=sua_jwt_secret_key_aqui
TOTP_ENCRYPTION_KEY=sua_totp_key_aqui
PII_MASTER_KEY=sua_pii_key_aqui

# App
APP_NAME=Terceiro Gestor
# Frontend origin(s): redirects, cookie policy, and the CORS allowlist.
# Comma-separated if there's more than one.
WEB_URL=http://localhost
TZ=America/Sao_Paulo

# Trusted proxy hops in front of this app (rate-limit/audit log use
# req.ip). 0 = none (safe default, use in dev). Only raise in
# production after confirming the real topology in staging.
TRUST_PROXY_HOPS=0

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@terceirogestor.local

# Storage (local = disco do container; r2 = Cloudflare R2, Parte 4.2)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Monitoramento de erros (Sentry). Sem DSN, roda sem reportar nada.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
