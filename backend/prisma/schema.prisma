model TaskOrganizerTask {
  id            String                @id @default(uuid()) @db.Char(36)
  tenantId      String                @db.Char(36)
  title         String
  summary       String?               @db.Text
  description   String?               @db.Text
  status        TaskOrganizerStatus   @default(BACKLOG)
  priority      TaskOrganizerPriority @default(MEDIUM)
  kind          TaskOrganizerKind     @default(FEATURE)
  owner         String?
  ownerUserId   String?               @db.Char(36)
  team          String?
  startDate     DateTime?
  dueDate       DateTime?
  isMilestone   Boolean               @default(false)
  progress      Int                   @default(0)
  effortPoints  Int?
  tags          Json?
  internalNotes String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant                Tenant                        @relation(fields: [tenantId], references: [id])
  ownerUser             User?                         @relation("TaskOrganizerAssignedUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  checklistItems        TaskOrganizerChecklistItem[]
  subtasks              TaskOrganizerSubtask[]
  comments              TaskOrganizerComment[]
  attachments           TaskOrganizerAttachment[]
  blockedByDependencies TaskOrganizerTaskDependency[] @relation("TaskOrganizerTaskBlockedBy")
  dependentTaskLinks    TaskOrganizerTaskDependency[] @relation("TaskOrganizerTaskBlocks")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, kind])
  @@index([tenantId, owner])
  @@index([ownerUserId])
  @@index([startDate])
  @@index([dueDate])
}

