model PantryEntry {
  id               String    @id @default(uuid()) @db.Char(36)
  tenantId         String    @db.Char(36)
  itemId           String    @db.Char(36)
  donorId          String?   @db.Char(36)
  sector           String
  quantity         Decimal   @db.Decimal(10, 2)
  unit             String
  entryDate        DateTime  @default(now())
  expiryDate       DateTime?
  notes            String?   @db.Text
  tags             String?   @db.Text
  internalNotes    String?   @db.Text
  reversalOfExitId String?   @db.Char(36)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  item            PantryItem              @relation(fields: [itemId], references: [id])
  donor           PantryDonor?            @relation(fields: [donorId], references: [id])
  exitAllocations PantryExitAllocation[]
  reversalOfExit  PantryExit?             @relation("PantryEntryReversalOfExit", fields: [reversalOfExitId], references: [id])
  reversalExits   PantryExit[]            @relation("PantryExitReversalOfEntry")
  comments        PantryEntryComment[]
  attachments     PantryEntryAttachment[]

  @@index([tenantId])
  @@index([itemId])
  @@index([donorId])
  @@index([sector])
  @@index([entryDate])
  @@index([expiryDate])
  @@index([reversalOfExitId])
}

model PantryExit {
  id                String         @id @default(uuid()) @db.Char(36)
  tenantId          String         @db.Char(36)
  itemId            String         @db.Char(36)
  sector            String
  quantity          Decimal        @db.Decimal(10, 2)
  unit              String
  exitDate          DateTime       @default(now())
