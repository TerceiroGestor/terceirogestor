  action         Activity @relation(fields: [actionId], references: [id])
  uploadedByUser User?    @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId])
  @@index([actionId])
  @@index([uploadedByUserId])
}

model ActivityPeopleGroup {
  id                String            @id @default(uuid()) @db.Char(36)
  tenantId          String            @db.Char(36)
  actionId          String            @db.Char(36)
  peopleGroupId     String            @db.Char(36)
  participationKind ParticipationKind @default(PARTICIPANT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  action      Activity    @relation(fields: [actionId], references: [id])
  peopleGroup PeopleGroup @relation(fields: [peopleGroupId], references: [id])

  @@unique([tenantId, actionId, peopleGroupId, participationKind])
  @@index([tenantId])
  @@index([actionId])
  @@index([peopleGroupId])
  @@index([participationKind])
  @@map("ActionPeopleGroup")
}

model Meeting {
  id                String           @id @default(uuid()) @db.Char(36)
  tenantId          String           @db.Char(36)
  actionId          String           @db.Char(36)
  /// Sempre preenchido - se o usuário não escrever nada na criação/edição,
  /// o service gera "Encontro - dd/mm/aaaa" automaticamente (2026-11-21).
  title             String           @default("")
  scheduledDate     DateTime         @db.Date
  startTime         DateTime
  endTime           DateTime?
  status            OccurrenceStatus @default(SCHEDULED)
  notes             String?          @db.Text
  planHtml          String?          @db.Text
  executedHtml      String?          @db.Text
  conclusionHtml    String?          @db.Text
  photoPaths        Json?
  recurrenceBatchId String?          @db.Char(36)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant           Tenant                        @relation(fields: [tenantId], references: [id])
  action           Activity                      @relation(fields: [actionId], references: [id])
  attendances      MeetingAttendance[]
  teamPeopleGroups ActionOccurrenceTeamGroup[]
  peopleGroups     ActionOccurrencePeopleGroup[]
  occurrenceCases  Occurrence[]
  teamParticipations MeetingTeamParticipation[]

  @@index([tenantId, actionId])
  @@index([tenantId, scheduledDate])
  @@index([recurrenceBatchId])
  @@map("ActionOccurrence")
}

model ActionOccurrenceTeamGroup {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @db.Char(36)
  occurrenceId  String   @db.Char(36)
  peopleGroupId String   @db.Char(36)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  occurrence  Meeting     @relation(fields: [occurrenceId], references: [id])
  peopleGroup PeopleGroup @relation(fields: [peopleGroupId], references: [id])

  @@unique([tenantId, occurrenceId, peopleGroupId])
  @@index([tenantId])
  @@index([occurrenceId])
  @@index([peopleGroupId])
}

/// N:N Encontro<->Grupos (substitui o antigo Meeting.peopleGroupId singular,
/// Ciclo 2 de ajustes da Fase 4, 2026-11-16): um Encontro pode atender N
/// Grupos de uma vez (evento amplo que junta todas as turmas), mesmo padrao
/// de ActionOccurrenceTeamGroup, so que para participationKind PARTICIPANT.
model ActionOccurrencePeopleGroup {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @db.Char(36)
  occurrenceId  String   @db.Char(36)
  peopleGroupId String   @db.Char(36)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  occurrence  Meeting     @relation(fields: [occurrenceId], references: [id])
  peopleGroup PeopleGroup @relation(fields: [peopleGroupId], references: [id])

  @@unique([tenantId, occurrenceId, peopleGroupId])
  @@index([tenantId])
  @@index([occurrenceId])
  @@index([peopleGroupId])
}

/// Fase 5 (Ocorrencia): registro rapido de um fato/incidente, com origem
/// opcional num Encontro (meetingId) ou registrada de forma independente
/// (demanda externa, meetingId nulo). Ciclo de status e avanco-so (ver
/// assertOccurrenceStatusTransition no service) - nao ha regressao.
model Occurrence {
  id           String               @id @default(uuid()) @db.Char(36)
  tenantId     String               @db.Char(36)
  meetingId    String?              @db.Char(36)
  title        String
  description  String?              @db.Text
  status       OccurrenceCaseStatus @default(REGISTRADA)
  outcomeNotes String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  meeting     Meeting?           @relation(fields: [meetingId], references: [id])
  people      OccurrencePeople[]
  attendances Attendance[]

  @@index([tenantId])
  @@index([meetingId])
  @@index([status])
}

model OccurrencePeople {
  id           String               @id @default(uuid()) @db.Char(36)
  tenantId     String               @db.Char(36)
  occurrenceId String               @db.Char(36)
  personId     String               @db.Char(36)
  role         OccurrencePersonRole @default(ENVOLVIDO)
  createdAt    DateTime             @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id])

  @@unique([occurrenceId, personId, role])
  @@index([tenantId])
  @@index([occurrenceId])
  @@index([personId])
}

model MeetingAttendance {
  id           String           @id @default(uuid()) @db.Char(36)
  tenantId     String           @db.Char(36)
  actionId     String           @db.Char(36)
  occurrenceId String           @db.Char(36)
  enrollmentId String           @db.Char(36)
  status       AttendanceStatus @default(PRESENT)
  notes        String?          @db.Text
  qualityScore Int?
  qualityNotes String?          @db.Text
  isHighlight  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  action     Activity          @relation(fields: [actionId], references: [id])
  occurrence Meeting           @relation(fields: [occurrenceId], references: [id])
  enrollment ProjectEnrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, occurrenceId, enrollmentId])
  @@index([tenantId])
  @@index([actionId])
  @@index([occurrenceId])
  @@index([enrollmentId])
  @@index([status])
  @@map("ProjectActionAttendance")
}

model ProjectActionPeopleParticipation {
  id                String                        @id @default(uuid()) @db.Char(36)
  tenantId          String                        @db.Char(36)
  actionId          String                        @db.Char(36)
  personId          String                        @db.Char(36)
  enrollmentId      String?                       @db.Char(36)
  participationKind ParticipationKind             @default(TEAM)
  role              ActionPeopleParticipationRole @default(PARTICIPANTE)
  activeKey         String?                       @db.VarChar(120)
  isActive          Boolean                       @default(true)
  startsAt          DateTime                      @default(now())
  endsAt            DateTime?
  deletedAt         DateTime?
  internalNotes     String?                       @db.Text
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  action     Activity           @relation(fields: [actionId], references: [id])
  person     Person             @relation(fields: [personId], references: [id])
  enrollment ProjectEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, activeKey])
  @@index([tenantId])
  @@index([actionId])
  @@index([personId])
  @@index([enrollmentId])
  @@index([participationKind])
  @@index([role])
  @@index([activeKey])
  @@index([isActive])
}

/// Equipe individual do Projeto (revisão da hierarquia de equipe,
/// 2026-11-21): mesma forma de ProjectActionPeopleParticipation, um
/// nível acima. Sem enrollmentId/participationKind - aqui é sempre
/// "equipe", não há o conceito de "público" no nível do Projeto.
model ProjectTeamParticipation {
  id            String                        @id @default(uuid()) @db.Char(36)
  tenantId      String                        @db.Char(36)
  projectId     String                        @db.Char(36)
  personId      String                        @db.Char(36)
  role          ActionPeopleParticipationRole @default(PARTICIPANTE)
  activeKey     String?                       @db.VarChar(120)
  isActive      Boolean                       @default(true)
  startsAt      DateTime                      @default(now())
  endsAt        DateTime?
  deletedAt     DateTime?
  internalNotes String?                       @db.Text
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([tenantId, activeKey])
  @@index([tenantId])
  @@index([projectId])
  @@index([personId])
  @@index([role])
  @@index([isActive])
}

/// Equipe individual do Encontro (revisão da hierarquia de equipe,
/// 2026-11-21): vínculo pontual pra aquele encontro específico, sem
/// janela de tempo (isActive/startsAt/endsAt) - mais parecido com
/// OccurrencePeople do que com ProjectActionPeopleParticipation. Ao
/// criar, o service encadeia a criação (se ainda não existir) do vínculo
/// equivalente em ProjectActionPeopleParticipation e ProjectTeamParticipation.
model MeetingTeamParticipation {
  id        String                        @id @default(uuid()) @db.Char(36)
  tenantId  String                        @db.Char(36)
  meetingId String                        @db.Char(36)
  personId  String                        @db.Char(36)
  role      ActionPeopleParticipationRole @default(PARTICIPANTE)
  createdAt DateTime                      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  meeting Meeting @relation(fields: [meetingId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([meetingId, personId, role])
  @@index([tenantId])
  @@index([meetingId])
  @@index([personId])
}

/// Fase 6 (Atendimento): prontuario tecnico (social/psicologico), com
/// controle de abertura/encerramento. Origem opcional num Occurrence
/// (espontaneo quando occurrenceId e nulo). Pessoas vinculadas (atendido
/// principal/secundario/familiar) sao adicionadas depois de criado, mesmo
/// padrao ja usado em Occurrence (Fase 5) - criar sempre abre em modo
/// create, sem pessoas ainda.
model Attendance {
  id             String               @id @default(uuid()) @db.Char(36)
  tenantId       String               @db.Char(36)
  occurrenceId   String?              @db.Char(36)
  type           AttendanceType
  scheduledDate  DateTime             @db.Date
  professionalId String               @db.Char(36)
  status         AttendanceCaseStatus @default(ABERTO)
  notes          String?              @db.Text
  closingNotes   String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  occurrence   Occurrence?           @relation(fields: [occurrenceId], references: [id])
  professional Person                @relation("AttendanceProfessional", fields: [professionalId], references: [id])
  people       AttendancePeople[]
  evolutions   AttendanceEvolution[]
  benefits     AttendanceBenefit[]

  @@index([tenantId])
  @@index([occurrenceId])
  @@index([professionalId])
  @@index([status])
  @@index([type])
}

model AttendancePeople {
  id           String               @id @default(uuid()) @db.Char(36)
  tenantId     String               @db.Char(36)
  attendanceId String               @db.Char(36)
  personId     String               @db.Char(36)
  role         AttendancePersonRole @default(ATENDIDO_PRINCIPAL)
  createdAt    DateTime             @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id])

  @@unique([attendanceId, personId, role])
  @@index([tenantId])
  @@index([attendanceId])
  @@index([personId])
}

/// Registro de evolucao - texto livre datado, multiplos por Attendance.
model AttendanceEvolution {
  id           String     @id @default(uuid()) @db.Char(36)
  tenantId     String     @db.Char(36)
  attendanceId String     @db.Char(36)
  date         DateTime   @db.Date
  notes        String     @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([attendanceId])
}

/// Beneficio concreto (cesta basica etc.) vinculado ao Attendance. Nome do
/// model nao pode ser "Benefit" generico porque colide em intencao com
/// "PersonBenefit" (beneficio social/financeiro continuo da pessoa, ja
/// existente) - sao conceitos diferentes, por isso "AttendanceBenefit".
model AttendanceBenefit {
  id           String     @id @default(uuid()) @db.Char(36)
  tenantId     String     @db.Char(36)
  attendanceId String     @db.Char(36)
  name         String
  date         DateTime   @db.Date
  quantity     Int?
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([attendanceId])
}

model PantryItem {
