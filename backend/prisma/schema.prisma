generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum IncomeFrequency {
  MONTHLY
  WEEKLY
  BIWEEKLY
  ANNUAL
  ONCE
}

enum AccessLogAction {
  LOGIN
  REFRESH
  LOGOUT
}

model Tenant {
  id        String       @id @default(uuid()) @db.Char(36)
  name      String       @unique
  logoUrl   String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users           User[]
  roles           Role[]
  people          Person[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  households      Household[]
  householdMembers HouseholdMember[]
  householdProfiles HouseholdProfile[]
  personRelations PersonRelation[]
  personIncomes   PersonIncome[]
  personExpenses  PersonExpense[]
  householdAssets HouseholdAsset[]
  personAssets    PersonAsset[]
  householdTransfers HouseholdTransfer[]
  personHealthConditions PersonHealthCondition[]
  personMedications PersonMedication[]
  userSessions    UserSession[]
  accessLogs      AccessLog[]

  @@index([status])
}

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @db.Char(36)
  name         String?
  email        String
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  roles  UserRole[]
  sessions UserSession[]
  accessLogs AccessLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @db.Char(36)
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @db.Char(36)
  roleId    String   @db.Char(36)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
}

model Person {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  fullName  String
  birthDate DateTime?
  socialName     String?
  sex            String?
  gender         String?
  raceColor      String?
  maritalStatus  String?
  nationality    String?
  email          String?
  phone          String?
  document       String?
  rg             String?
  nis            String?
  status         String?
  departureReason String? @db.Text
  tags           String? @db.Text
  hasHealthIssue Boolean  @default(false)
  notes          String? @db.Text
  profileSummary String? @db.Text
  avatarUrl      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  householdMembers HouseholdMember[]
  relations PersonRelation[] @relation("PersonRelationPerson")
  relatedRelations PersonRelation[] @relation("PersonRelationRelated")
  incomes PersonIncome[]
  expenses PersonExpense[]
  assets  PersonAsset[]
  transfers HouseholdTransfer[]
  healthConditions PersonHealthCondition[]
  medications PersonMedication[]

  @@index([tenantId])
  @@index([fullName])
}

model Household {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  members HouseholdMember[]
  profile HouseholdProfile?
  assets  HouseholdAsset[]
  incomes PersonIncome[]
  expenses PersonExpense[]
  outgoingTransfers HouseholdTransfer[] @relation("HouseholdTransferFrom")
  incomingTransfers HouseholdTransfer[] @relation("HouseholdTransferTo")

  @@index([tenantId])
}

model HouseholdMember {
  id                  String   @id @default(uuid()) @db.Char(36)
  tenantId            String   @db.Char(36)
  householdId         String   @db.Char(36)
  personId            String   @db.Char(36)
  role                String?
  isLegalGuardian     Boolean  @default(false)
  isHouseholdHead     Boolean  @default(false)
  isIncomeContributor Boolean  @default(false)
  isProvider          Boolean  @default(false)
  isDependent         Boolean  @default(false)
  notes               String?  @db.Text
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])
  person    Person    @relation(fields: [personId], references: [id])

  @@unique([householdId, personId])
  @@index([tenantId])
  @@index([householdId])
  @@index([personId])
}

model HouseholdProfile {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  householdId String   @unique @db.Char(36)
  type        String?
  condition   String?
  ownership   String?
  areaM2      Float?
  rooms       Int?
  bathrooms   Int?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@index([tenantId])
}

model HouseholdAsset {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  householdId String   @db.Char(36)
  category    String
  item        String
  quantity    Int?     @default(1)
  condition   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([householdId])
}

model PersonAsset {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  personId  String   @db.Char(36)
  category  String
  item      String
  quantity  Int?     @default(1)
  condition String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

model PersonIncome {
  id                     String          @id @default(uuid()) @db.Char(36)
  tenantId               String          @db.Char(36)
  personId               String          @db.Char(36)
  householdId            String?         @db.Char(36)
  type                   String
  amount                 Decimal         @db.Decimal(10, 2)
  frequency              IncomeFrequency @default(MONTHLY)
  contractType           String?
  isHouseholdContribution Boolean        @default(true)
  notes                  String?         @db.Text
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
}

model PersonRelation {
  id               String   @id @default(uuid()) @db.Char(36)
  tenantId         String   @db.Char(36)
  personId         String   @db.Char(36)
  relatedPersonId  String   @db.Char(36)
  type             String
  livesTogether    Boolean  @default(false)
  isLegalGuardian  Boolean  @default(false)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  person        Person @relation("PersonRelationPerson", fields: [personId], references: [id])
  relatedPerson Person @relation("PersonRelationRelated", fields: [relatedPersonId], references: [id])

  @@unique([tenantId, personId, relatedPersonId, type])
  @@index([tenantId])
  @@index([personId])
  @@index([relatedPersonId])
}

model PersonExpense {
  id        String          @id @default(uuid()) @db.Char(36)
  tenantId  String          @db.Char(36)
  personId  String          @db.Char(36)
  householdId String?       @db.Char(36)
  type      String
  amount    Decimal         @db.Decimal(10, 2)
  frequency IncomeFrequency @default(MONTHLY)
  isHouseholdExpense Boolean @default(true)
  notes     String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
}

model PersonHealthCondition {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @db.Char(36)
  personId      String   @db.Char(36)
  type          String
  description   String?  @db.Text
  severity      String?
  diagnosisDate DateTime?
  documentUrl   String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

model PersonMedication {
  id                   String   @id @default(uuid()) @db.Char(36)
  tenantId             String   @db.Char(36)
  personId             String   @db.Char(36)
  reason               String?
  medication           String
  dosage               String?
  schedule             String?
  startDate            DateTime?
  endDate              DateTime?
  prescribingDoctor    String?
  permissionDocumentUrl String?
  documentUrl          String?
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

enum HouseholdTransferType {
  PENSION
  TRANSFER
}

model HouseholdTransfer {
  id              String                @id @default(uuid()) @db.Char(36)
  tenantId        String                @db.Char(36)
  personId        String                @db.Char(36)
  fromHouseholdId String                @db.Char(36)
  toHouseholdId   String                @db.Char(36)
  type            HouseholdTransferType @default(PENSION)
  amount          Decimal               @db.Decimal(10, 2)
  frequency       IncomeFrequency       @default(MONTHLY)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  person        Person    @relation(fields: [personId], references: [id])
  fromHousehold Household @relation("HouseholdTransferFrom", fields: [fromHouseholdId], references: [id])
  toHousehold   Household @relation("HouseholdTransferTo", fields: [toHouseholdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([fromHouseholdId])
  @@index([toHouseholdId])
}


model UserSession {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @db.VarChar(128)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model AccessLog {
  id        String          @id @default(uuid()) @db.Char(36)
  tenantId  String          @db.Char(36)
  userId    String          @db.Char(36)
  action    AccessLogAction
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}
