model DepositEntry {
  id               String    @id @default(uuid()) @db.Char(36)
  tenantId         String    @db.Char(36)
  itemId           String    @db.Char(36)
  donorId          String?   @db.Char(36)
  sector           String
  quantity         Decimal   @db.Decimal(10, 2)
  unit             String
  entryDate        DateTime  @default(now())
  expiryDate       DateTime?
  notes            String?   @db.Text
  tags             String?   @db.Text
  internalNotes    String?   @db.Text
  reversalOfExitId String?   @db.Char(36)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  item            DepositItem              @relation(fields: [itemId], references: [id])
  donor           DepositDonor?            @relation(fields: [donorId], references: [id])
  exitAllocations DepositExitAllocation[]
  reversalOfExit  DepositExit?             @relation("DepositEntryReversalOfExit", fields: [reversalOfExitId], references: [id])
  reversalExits   DepositExit[]            @relation("DepositExitReversalOfEntry")
  comments        DepositEntryComment[]
  attachments     DepositEntryAttachment[]

  @@index([tenantId])
  @@index([itemId])
  @@index([donorId])
  @@index([sector])
  @@index([entryDate])
  @@index([expiryDate])
  @@index([reversalOfExitId])
}

model DepositExit {
  id                String          @id @default(uuid()) @db.Char(36)
  tenantId          String          @db.Char(36)
  itemId            String          @db.Char(36)
  sector            String
  quantity          Decimal         @db.Decimal(10, 2)
  unit              String
  exitDate          DateTime        @default(now())
  type              DepositExitType @default(FINAL_REMOVAL)
  destinationName   String?
  destinationType   String?
  expectedReturnAt  DateTime?
  returnedAt        DateTime?
  returnedQuantity  Decimal?        @db.Decimal(10, 2)
  returnNotes       String?         @db.Text
  notes             String?         @db.Text
  tags              String?         @db.Text
  internalNotes     String?         @db.Text
  reversalOfEntryId String?         @db.Char(36)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  item            DepositItem             @relation(fields: [itemId], references: [id])
  allocations     DepositExitAllocation[]
  reversalOfEntry DepositEntry?           @relation("DepositExitReversalOfEntry", fields: [reversalOfEntryId], references: [id])
  reversalEntries DepositEntry[]          @relation("DepositEntryReversalOfExit")
  comments        DepositExitComment[]
  attachments     DepositExitAttachment[]

  @@index([tenantId])
  @@index([itemId])
  @@index([sector])
  @@index([exitDate])
  @@index([reversalOfEntryId])
}

model DepositExitAllocation {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
