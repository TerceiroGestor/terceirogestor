model Household {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                   Tenant                 @relation(fields: [tenantId], references: [id])
  members                  HouseholdMember[]
  profile                  HouseholdProfile?
  financialEntries         PersonFinancialEntry[]
  outgoingFinancialEntries PersonFinancialEntry[] @relation("PersonFinancialEntryFromHousehold")
  incomingFinancialEntries PersonFinancialEntry[] @relation("PersonFinancialEntryToHousehold")
  assets                   HouseholdAsset[]
  incomes                  PersonIncome[]
  expenses                 PersonExpense[]
  benefits                 PersonBenefit[]
  outgoingTransfers        HouseholdTransfer[]    @relation("HouseholdTransferFrom")
  incomingTransfers        HouseholdTransfer[]    @relation("HouseholdTransferTo")

  @@index([tenantId])
}

model HouseholdMember {
  id                  String    @id @default(uuid()) @db.Char(36)
  tenantId            String    @db.Char(36)
  householdId         String    @db.Char(36)
  personId            String    @db.Char(36)
  role                String?
  isLegalGuardian     Boolean   @default(false)
  isHouseholdHead     Boolean   @default(false)
  isIncomeContributor Boolean   @default(false)
  isProvider          Boolean   @default(false)
  isDependent         Boolean   @default(false)
  notes               String?   @db.Text
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])
  person    Person    @relation(fields: [personId], references: [id])

  @@unique([householdId, personId])
  @@index([tenantId])
  @@index([householdId])
  @@index([personId])
}

model HouseholdProfile {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @db.Char(36)
  householdId  String   @unique @db.Char(36)
  type         String?
  condition    String?
  ownership    String?
  areaM2       Float?
  rooms        Int?
  bathrooms    Int?
  cep          String?  @db.VarChar(8)
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?  @db.VarChar(2)
  ibge         String?  @db.VarChar(7)
  gia          String?
  ddd          String?  @db.VarChar(3)
  siafi        String?  @db.VarChar(4)
  reference    String?  @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([tenantId, cep])
}

model HouseholdAsset {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  householdId String   @db.Char(36)
  category    String
  item        String
  quantity    Int?     @default(1)
  condition   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([householdId])
}

model PersonAsset {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  personId  String   @db.Char(36)
  category  String
  item      String
  quantity  Int?     @default(1)
  condition String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

model PersonIncome {
  id                      String          @id @default(uuid()) @db.Char(36)
  tenantId                String          @db.Char(36)
  personId                String          @db.Char(36)
  householdId             String?         @db.Char(36)
  type                    String
  amount                  Decimal         @db.Decimal(10, 2)
  frequency               IncomeFrequency @default(MONTHLY)
  contractType            String?
  isHouseholdContribution Boolean         @default(true)
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  person    Person     @relation(fields: [personId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
}

model PersonFinancialEntry {
  id                       String                   @id @default(uuid()) @db.Char(36)
  tenantId                 String                   @db.Char(36)
  personId                 String                   @db.Char(36)
  householdId              String?                  @db.Char(36)
  fromHouseholdId          String?                  @db.Char(36)
  toHouseholdId            String?                  @db.Char(36)
  entryType                PersonFinancialEntryType
  category                 String
  subcategory              String?
  status                   String?
  amount                   Decimal?                 @db.Decimal(10, 2)
  frequency                IncomeFrequency          @default(MONTHLY)
  contractType             String?
  includeInHouseholdBudget Boolean                  @default(true)
  startDate                DateTime?
  endDate                  DateTime?
  notes                    String?                  @db.Text
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  person        Person     @relation(fields: [personId], references: [id])
  household     Household? @relation(fields: [householdId], references: [id])
  fromHousehold Household? @relation("PersonFinancialEntryFromHousehold", fields: [fromHouseholdId], references: [id])
  toHousehold   Household? @relation("PersonFinancialEntryToHousehold", fields: [toHouseholdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
  @@index([fromHouseholdId])
  @@index([toHouseholdId])
  @@index([entryType])
  @@index([tenantId, personId, entryType])
}

model PersonRelation {
  id              String   @id @default(uuid()) @db.Char(36)
  tenantId        String   @db.Char(36)
  personId        String   @db.Char(36)
  relatedPersonId String   @db.Char(36)
  type            String
  livesTogether   Boolean  @default(false)
  isLegalGuardian Boolean  @default(false)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  person        Person @relation("PersonRelationPerson", fields: [personId], references: [id])
  relatedPerson Person @relation("PersonRelationRelated", fields: [relatedPersonId], references: [id])

  @@unique([tenantId, personId, relatedPersonId, type])
  @@index([tenantId])
  @@index([personId])
  @@index([relatedPersonId])
}

model PersonExpense {
  id                 String          @id @default(uuid()) @db.Char(36)
  tenantId           String          @db.Char(36)
  personId           String          @db.Char(36)
  householdId        String?         @db.Char(36)
  type               String
  amount             Decimal         @db.Decimal(10, 2)
  frequency          IncomeFrequency @default(MONTHLY)
  isHouseholdExpense Boolean         @default(true)
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  person    Person     @relation(fields: [personId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
}

model PersonBenefit {
  id          String          @id @default(uuid()) @db.Char(36)
  tenantId    String          @db.Char(36)
  personId    String          @db.Char(36)
  householdId String?         @db.Char(36)
  type        String
  status      String?
  amount      Decimal?        @db.Decimal(10, 2)
  frequency   IncomeFrequency @default(MONTHLY)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  person    Person     @relation(fields: [personId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([householdId])
  @@index([tenantId, personId])
}

model PersonDetention {
  id        String    @id @default(uuid()) @db.Char(36)
  tenantId  String    @db.Char(36)
  personId  String    @db.Char(36)
  status    String
  type      String?
  unit      String?
  startDate DateTime?
  endDate   DateTime?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([tenantId, personId])
}

model PersonHealthCondition {
  id            String    @id @default(uuid()) @db.Char(36)
  tenantId      String    @db.Char(36)
  personId      String    @db.Char(36)
  type          String
  description   String?   @db.Text
  severity      String?
  diagnosisDate DateTime?
  documentUrl   String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

model PersonMedication {
  id                    String    @id @default(uuid()) @db.Char(36)
  tenantId              String    @db.Char(36)
  personId              String    @db.Char(36)
  reason                String?
  medication            String
  dosage                String?
  schedule              String?
  startDate             DateTime?
  endDate               DateTime?
  prescribingDoctor     String?
  permissionDocumentUrl String?
  documentUrl           String?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
}

model PersonEducation {
  id          String    @id @default(uuid()) @db.Char(36)
  tenantId    String    @db.Char(36)
  personId    String    @db.Char(36)
  level       String
  status      String?
  institution String?
  grade       String?
  schoolYear  String?
  isCurrent   Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([tenantId, personId])
}

model HouseholdTransfer {
  id              String                @id @default(uuid()) @db.Char(36)
  tenantId        String                @db.Char(36)
  personId        String                @db.Char(36)
  fromHouseholdId String                @db.Char(36)
  toHouseholdId   String                @db.Char(36)
  type            HouseholdTransferType @default(PENSION)
  amount          Decimal               @db.Decimal(10, 2)
  frequency       IncomeFrequency       @default(MONTHLY)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  person        Person    @relation(fields: [personId], references: [id])
  fromHousehold Household @relation("HouseholdTransferFrom", fields: [fromHouseholdId], references: [id])
  toHousehold   Household @relation("HouseholdTransferTo", fields: [toHouseholdId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@index([fromHouseholdId])
  @@index([toHouseholdId])
}
